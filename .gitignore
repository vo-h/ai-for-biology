*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.env
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Large data / results / model artifacts
results/*.h5ad
results/*.npy
results/*.pkl
*.h5ad
*.loom
*.pt
*.pth
*.ckpt

# Terraform
# .terraform/ is a local plugin/module cache regenerated by `terraform init` —
# never commit it (this is what blew up git history with a 648MB provider
# binary). *.tfstate holds real infra state (and can contain secrets) — use a
# remote backend, not git, for state. .terraform.lock.hcl is intentionally
# NOT ignored: it pins provider versions and should be committed.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
**.terraform.lock.hcl

# OS
.DS_Store
*.code-workspace
**.claude